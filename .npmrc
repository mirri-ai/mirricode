auto-install-peers=true
engine-strict=true
strict-peer-dependencies=false
registry=https://registry.npmjs.org

# Electron binary mirrors: the runtime zip (~100MB) and electron-builder toolsets
# download from GitHub's release CDN by default, which is unreachable from
# restricted/corporate networks. npmmirror hosts byte-identical artifacts, so
# downloads are stable everywhere while staying a no-op on networks where
# GitHub is reachable (only used when a download is actually needed; the
# artifact is then cached in ~/Library/Caches/electron or ~/.cache/electron).
# Uncomment on networks where GitHub's release CDN is unreachable:
#electron_mirror=https://npmmirror.com/mirrors/electron/
#electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
