{
  "name": "@mirri-ai/monorepo",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r --filter './packages/*' run build",
    "dev:cli": "pnpm -C apps/mirri-code run dev",
    "dev:cli:marketplace": "MIRRICODE_DEV_MARKETPLACE_URL=https://mirricode.com/plugins/marketplace.json pnpm -C apps/mirri-code run dev",
    "dev:web": "pnpm -C apps/mirri-web run dev",
    "dev:desktop": "pnpm -C apps/mirri-desktop run dev",
    "dev:server": "pnpm -C apps/mirri-code run dev:server",
    "dev:v1": "pnpm -C apps/mirri-code run dev:server",
    "dev:v2": "pnpm -C apps/mirri-code run dev:kap-server:multi",
    "dev:web:v2": "MIRRICODE_SERVER_URL=http://127.0.0.1:56129 pnpm -C apps/mirri-web run dev",
    "build:plugin-marketplace": "pnpm -C apps/mirri-code run build:plugin-marketplace",
    "vis": "pnpm -C apps/vis run dev",
    "dev:docs": "pnpm -C docs install --ignore-workspace && pnpm -C docs run dev",
    "typecheck": "pnpm run build:packages && pnpm -r --filter './packages/*' run typecheck && pnpm --filter @mirri-ai/mirri-code run typecheck && pnpm --filter @mirri-ai/mirri-web run typecheck && pnpm --filter @mirri-ai/vis-server run typecheck && pnpm --filter @mirri-ai/vis-web run typecheck && pnpm --filter @mirri-ai/mirri-desktop run typecheck",
    "lint": "oxlint --type-aware",
    "lint:fix": "pnpm run lint --fix",
    "lint:pkg": "pnpm --filter @mirri-ai/mirri-code exec publint && npm_config_cache=${TMPDIR:-/tmp}/mirri-code-npm-cache pnpm --filter @mirri-ai/mirri-code exec attw --pack . --profile node16",
    "sherif": "sherif",
    "test": "vitest run",
    "test:e2e": "vitest run --testNamePattern='e2e|golden|real engine|subagent|Server WS' packages/e2e-harness packages/acp-adapter packages/node-sdk packages/kap-server packages/server apps/mirri-web",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "pnpm -r run clean",
    "changeset": "changeset",
    "version": "changeset version",
    "version:release": "changeset version",
    "publish": "pnpm run typecheck && pnpm run lint && pnpm run sherif && pnpm run test && pnpm run build && pnpm run lint:pkg && changeset publish",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.30.0",
    "@jsquash/webp": "^1.5.0",
    "@microsoft/api-extractor": "7.58.7",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.3",
    "@vitest/browser": "4.1.4",
    "@vitest/coverage-v8": "4.1.4",
    "lint-staged": "16.4.0",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.24.0",
    "pkg-pr-new": "0.0.75",
    "playwright": "^1.62.1",
    "publint": "0.3.18",
    "sherif": "1.11.1",
    "simple-git-hooks": "2.13.1",
    "tsdown": "0.22.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --quiet",
      "oxlint --type-aware --quiet"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.0"
}
