{
  "name": "@mirri-ai/monorepo",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r --filter './packages/*' run build",
    "dev:web": "pnpm -C apps/mirri-web run dev",
    "dev:desktop": "pnpm -C apps/mirri-desktop run dev",
    "dev:rust": "cargo run --manifest-path rust/Cargo.toml -p mirri-cli -- serve",
    "dev:web:rust": "MIRRICODE_BACKEND=rust pnpm -C apps/mirri-web run dev",
    "dev:docs": "pnpm -C docs run dev",
    "typecheck": "pnpm run build:packages && pnpm -r --filter './packages/*' run typecheck && pnpm --filter @mirri-ai/mirri-web run typecheck && pnpm --filter @mirri-ai/mirri-desktop run typecheck",
    "lint": "oxlint --type-aware",
    "lint:fix": "pnpm run lint --fix",
    "sherif": "sherif",
    "test": "MIRRICODE_E2E_SKIP_RUST=1 pnpm -C apps/mirri-web run test && pnpm --filter @mirri-ai/mirri-desktop run test",
    "test:e2e": "pnpm -C apps/mirri-web run test -- --testNamePattern='e2e|golden|real engine|subagent|Server WS'",
    "test:watch": "pnpm -C apps/mirri-web run test -- --watch",
    "test:coverage": "pnpm -C apps/mirri-web run test -- --coverage && pnpm --filter @mirri-ai/mirri-desktop run test -- --coverage",
    "clean": "pnpm -r run clean",
    "gate:rust-zero-io": "node rust/scripts/check-zero-io.mjs",
    "gate:rust-test-hygiene": "node rust/scripts/check-test-hygiene.mjs",
    "check:spawn": "node scripts/check-spawn-usage.mjs",
    "gate": "node scripts/gate.mjs",
    "gate:rust": "node scripts/gate.mjs --rust",
    "gate:full": "node scripts/gate.mjs --full",
    "gate:real": "node scripts/gate.mjs --real",
    "changeset": "changeset",
    "version": "changeset version && node rust/scripts/sync-version.mjs",
    "version:release": "pnpm run version",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.30.0",
    "@jsquash/webp": "^1.5.0",
    "@microsoft/api-extractor": "7.58.12",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.3",
    "@types/yazl": "^2.4.6",
    "@vitest/browser": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "lint-staged": "16.4.0",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.24.0",
    "playwright": "^1.62.1",
    "sherif": "1.11.1",
    "simple-git-hooks": "2.13.1",
    "tsdown": "0.22.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.12",
    "yazl": "^3.3.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm gate"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --quiet",
      "oxlint --type-aware --quiet"
    ]
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "sherif": {
    "ignoreRule": [
      "root-package-manager-field"
    ]
  }
}
